# ChessBench environment template. Copy to `.env` and fill in as needed.
# `.env` is gitignored; never commit real credentials.
# All values are optional — a provider with no endpoint reports `unavailable`.

# UI server port (default 3210).
PORT=3210

# --- JEV (TypeSafe SystemOne) — requires API key + endpoint ---
JEV_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
# Optional: pin a checkpoint (default `jev-latest`).
JEV_MODEL=

# --- Laya (local System One server) — keyless; endpoint required ---
LAYA_ENDPOINT=http://localhost:8000/v1/systemone
# Optional: only needed if the server sets LAYA_API_KEY.
LAYA_API_KEY=
# Optional: pin a checkpoint (default `laya-latest`).
LAYA_MODEL=

# --- Nimble (local Ollama-fronted System One) — keyless; endpoint required ---
NIMBLE_ENDPOINT=http://localhost:11434/v1/systemone
# Optional: only needed if the server requires a bearer token.
NIMBLE_API_KEY=
# Optional: model id the endpoint serves (default `nimble`).
NIMBLE_MODEL=


# --- Tev1 (local Ollama-fronted System One) — keyless; endpoint required ---
TEV_ENDPOINT=http://localhost:11434/v1/systemone
# Optional: only needed if the server requires a bearer token.
TEV_API_KEY=
# Optional: model id the endpoint serves (default `tev1:0.8b`).
TEV_MODEL=
